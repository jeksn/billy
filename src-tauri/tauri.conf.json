{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "billy",
    "version": "0.1.0",
    "identifier": "dev.billy.app",
    "build": {
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "",
                "titleBarStyle": "Overlay",
                "width": 1200,
                "height": 800,
                "minWidth": 900,
                "minHeight": 600
            }
        ],
        "security": {
            "csp": "default-src 'self' blob:; script-src 'self'; style-src 'self' blob: 'unsafe-inline'; img-src 'self' blob: data: asset: http://asset.localhost; connect-src 'self' blob: data:; frame-src blob: data:; object-src blob: data:; form-action 'none'",
            "assetProtocol": {
                "enable": true,
                "scope": []
            },
            "capabilities": ["default"]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
